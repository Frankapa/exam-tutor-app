# Copy this file to ".env" and fill in your real key.
# Get a free key (no card required) from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Optional: change the port the server runs on
PORT=4000

# Which Gemini model to use for tutor responses.
# gemini-3.5-flash-lite is Google's high-volume, cost-sensitive model —
# built for exactly this pattern (lots of small, simple calls) and has a
# much higher free daily quota than the general-purpose "flash" models.
GEMINI_MODEL=gemini-3.5-flash-lite
