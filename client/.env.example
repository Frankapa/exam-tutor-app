# By default this is unset, which means the app calls relative paths like
# "/api/tutor/ask". That works during local development because
# vite.config.js proxies /api requests to the backend on localhost:4000.
#
# Once your backend is deployed (e.g. to Render), copy this file to ".env"
# and set this to your deployed backend's URL, with no trailing slash:
#
# VITE_API_BASE_URL=https://your-app-name.onrender.com
